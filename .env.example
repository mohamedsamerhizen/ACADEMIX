# Local Docker Compose configuration. Copy to .env and replace all CHANGE_ME values.
# .env is not automatically read by dotnet run.
POSTGRES_PASSWORD=CHANGE_ME
JWT_SIGNING_KEY=CHANGE_ME
MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME
# Set a valid QuestPDF category appropriate to your use; tests use Evaluation.
DOCUMENTS_PDF_LICENSE=
BOOTSTRAP_ENABLED=false
BOOTSTRAP_EMAIL=
BOOTSTRAP_PASSWORD=
