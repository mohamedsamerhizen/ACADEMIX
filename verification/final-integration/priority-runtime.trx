      CREATE TABLE campus_room_reservations (&#xD;
          "Id" uuid NOT NULL,&#xD;
          "InstitutionId" uuid NOT NULL,&#xD;
          "RoomId" uuid NOT NULL,&#xD;
          "Kind" character varying(20) NOT NULL,&#xD;
          "SectionId" uuid,&#xD;
          "ExamId" uuid,&#xD;
          "InvigilatorId" uuid,&#xD;
          "SeatCount" integer,&#xD;
          "StartsAtUtc" timestamp with time zone NOT NULL,&#xD;
          "EndsAtUtc" timestamp with time zone NOT NULL,&#xD;
          "Status" character varying(20) NOT NULL,&#xD;
          "ClientRequestId" uuid NOT NULL,&#xD;
          "Reason" character varying(500) NOT NULL,&#xD;
          "CreatedBy" uuid NOT NULL,&#xD;
          "CreatedAtUtc" timestamp with time zone NOT NULL,&#xD;
          "CancelledBy" uuid,&#xD;
          "CancelledAtUtc" timestamp with time zone,&#xD;
          "CancellationReason" character varying(500) NOT NULL,&#xD;
          "Version" bigint NOT NULL,&#xD;
          CONSTRAINT "PK_campus_room_reservations" PRIMARY KEY ("Id"),&#xD;
          CONSTRAINT "CK_p22_reservation_times" CHECK ("EndsAtUtc" &gt; "StartsAtUtc"),&#xD;
          CONSTRAINT "CK_p22_reservation_status" CHECK ("Status" IN ('Active','Cancelled')),&#xD;
          CONSTRAINT "CK_p22_reservation_kind" CHECK ("Kind" IN ('Maintenance','Exam')),&#xD;
          CONSTRAINT "CK_p22_reservation_shape" CHECK (("Kind" = 'Maintenance' AND "SectionId" IS NULL AND "ExamId" IS NULL AND "InvigilatorId" IS NULL AND "SeatCount" IS NULL) OR ("Kind" = 'Exam' AND "SectionId" IS NOT NULL AND "ExamId" IS NOT NULL AND "InvigilatorId" IS NOT NULL AND "SeatCount" BETWEEN 1 AND 10000)),&#xD;
          CONSTRAINT "FK_reservation_room" FOREIGN KEY ("RoomId", "InstitutionId") REFERENCES campus_rooms ("Id", "InstitutionId") ON DELETE RESTRICT,&#xD;
          CONSTRAINT "FK_reservation_section" FOREIGN KEY ("SectionId", "InstitutionId") REFERENCES course_sections ("Id", "InstitutionId") ON DELETE RESTRICT,&#xD;
          CONSTRAINT "FK_reservation_exam" FOREIGN KEY ("ExamId") REFERENCES exam_definitions ("Id") ON DELETE RESTRICT,&#xD;
          CONSTRAINT "FK_reservation_invigilator" FOREIGN KEY ("InvigilatorId") REFERENCES identity_users ("Id") ON DELETE RESTRICT,&#xD;
          CONSTRAINT "FK_reservation_created_by" FOREIGN KEY ("CreatedBy") REFERENCES identity_users ("Id") ON DELETE RESTRICT,&#xD;
          CONSTRAINT "FK_reservation_cancelled_by" FOREIGN KEY ("CancelledBy") REFERENCES identity_users ("Id") ON DELETE RESTRICT&#xD;
      );&#xD;
