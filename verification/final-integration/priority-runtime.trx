      SELECT f."Currency", f0."Method", COALESCE(sum(CASE&#xD;
          WHEN f."Kind" = 'PaymentPosted' THEN f."AmountMinor"::numeric&#xD;
          ELSE CAST(-f."AmountMinor" AS numeric)&#xD;
      END), 0.0) AS "Amount"&#xD;
      FROM finance_journals AS f&#xD;
      INNER JOIN finance_payments AS f0 ON f."PaymentId" = f0."Id"&#xD;
      WHERE f."InstitutionId" = @inst AND f."PostedAtUtc" &lt; @asOf AND f."PostedAtUtc" &gt;= @start AND f."Kind" IN ('PaymentPosted', 'PaymentReversed')&#xD;
      GROUP BY f."Currency", f0."Method"&#xD;
