          "Quantity" integer NOT NULL,&#xD;
          "Points" numeric(8,2) NOT NULL,&#xD;
          CONSTRAINT "PK_exam_question_pools" PRIMARY KEY ("Id"),&#xD;
          CONSTRAINT "CK_exam_question_pools_quantity" CHECK ("Quantity" BETWEEN 1 AND 200),&#xD;
