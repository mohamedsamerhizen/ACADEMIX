      SELECT f."InvoiceId" AS "Id", COALESCE(sum(CASE&#xD;
          WHEN f."Kind" = 'ScholarshipGranted' THEN f."AmountMinor"&#xD;
          ELSE -f."AmountMinor"&#xD;
      END), 0.0)::bigint AS "Amount"&#xD;
      FROM finance_journals AS f&#xD;
      WHERE f."InstitutionId" = @inst AND f."PostedAtUtc" &lt; @cutoff AND f."InvoiceId" IS NOT NULL AND f."InvoiceId" IN (&#xD;
          SELECT f0."Id"&#xD;
          FROM finance_invoices AS f0&#xD;
          WHERE f0."InstitutionId" = @inst AND f0."Status" &lt;&gt; 'Draft' AND f0."PostedAtUtc" &lt; @cutoff3 AND f0."AccountId" = @account&#xD;
      ) AND f."Kind" IN ('ScholarshipGranted', 'ScholarshipReclaimed')&#xD;
      GROUP BY f."InvoiceId"&#xD;
