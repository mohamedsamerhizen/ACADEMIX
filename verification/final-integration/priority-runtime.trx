      Executed DbCommand (2ms) [Parameters=[@now='?' (DbType = DateTime), @institution='?' (DbType = Guid), @queues='?' (DbType = Object)], CommandType='Text', CommandTimeout='30']&#xD;
      SELECT count(*)::int AS "Total", count(*) FILTER (WHERE s0."Status" NOT IN ('Closed', 'Rejected', 'Cancelled', 'Resolved'))::int AS "Open", count(*) FILTER (WHERE s0."DueAtUtc" &lt; @now AND s0."Status" &lt;&gt; 'Closed' AND s0."Status" &lt;&gt; 'Rejected' AND s0."Status" &lt;&gt; 'Cancelled' AND s0."Status" &lt;&gt; 'Resolved')::int AS "Overdue", count(*) FILTER (WHERE s0."Status" = 'AwaitingStudent')::int AS "Awaiting", count(*) FILTER (WHERE s0."Status" = 'Resolved')::int AS "Resolved", count(*) FILTER (WHERE s0."Status" IN ('Closed', 'Rejected', 'Cancelled'))::int AS "Closed", count(*) FILTER (WHERE s0."AssignedStaffId" IS NULL AND s0."Status" &lt;&gt; 'Closed' AND s0."Status" &lt;&gt; 'Rejected' AND s0."Status" &lt;&gt; 'Cancelled' AND s0."Status" &lt;&gt; 'Resolved')::int AS "Unassigned", count(*) FILTER (WHERE s0."Priority" = 'Urgent' AND s0."Status" &lt;&gt; 'Closed' AND s0."Status" &lt;&gt; 'Rejected' AND s0."Status" &lt;&gt; 'Cancelled')::int AS "Urgent"&#xD;
      FROM (&#xD;
          SELECT s."AssignedStaffId", s."DueAtUtc", s."Priority", s."Status", 1 AS "Key"&#xD;
          FROM student_service_cases AS s&#xD;
          WHERE s."InstitutionId" = @institution AND s."CurrentQueueCode" = ANY (@queues)&#xD;
      ) AS s0&#xD;
      GROUP BY s0."Key"&#xD;
      LIMIT 2&#xD;
