info: Microsoft.EntityFrameworkCore.Database.Command[20101]&#xD;
      Executed DbCommand (1ms) [Parameters=[@inst='?' (DbType = Guid), @cutoff='?' (DbType = DateTime), @cutoff3='?' (DbType = DateTime), @account='?' (DbType = Guid)], CommandType='Text', CommandTimeout='30']&#xD;
      SELECT f."InvoiceId" AS "Id", COALESCE(sum(f."SignedMinor"), 0.0)::bigint AS "Amount"&#xD;
      FROM finance_adjustments AS f&#xD;
      INNER JOIN (&#xD;
          SELECT f0."Id"&#xD;
          FROM finance_journals AS f0&#xD;
          WHERE f0."InstitutionId" = @inst AND f0."PostedAtUtc" &lt; @cutoff&#xD;
