          CONSTRAINT "CK_p20_session" CHECK ("Status" IN ('Scheduled','Completed','Cancelled') AND "StudentId" &lt;&gt; "AdvisorId" AND ("AcknowledgedAtUtc" IS NULL OR "Status" = 'Completed')),&#xD;
