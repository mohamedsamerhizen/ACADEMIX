      INSERT INTO institutional_outbox_events ("Id","InstitutionId","ImportRowId","Kind","PayloadJson","CreatedAtUtc","DeduplicationKey","Status","Attempts")&#xD;
SELECT gen_random_uuid(),a."InstitutionId",NULL,'ScheduledAnnouncement',jsonb_build_object('AnnouncementId',a."Id"),@p0,&#xD;
    'ScheduledAnnouncement:'||replace(a."Id"::text,'-',''),'Pending',0&#xD;
FROM communication_announcements a JOIN institutions i ON i."Id"=a."InstitutionId"&#xD;
WHERE NOT a."IsCancelled" AND a."DispatchedAtUtc" IS NULL AND a."ScheduledForUtc"&lt;=@p1 AND i."IsActive"&#xD;
ON CONFLICT ("InstitutionId","DeduplicationKey") DO NOTHING&#xD;
info: Microsoft.EntityFrameworkCore.Database.Command[20101]&#xD;
      Executed DbCommand (1ms) [Parameters=[p0='?' (DbType = DateTime), p1='?' (DbType = DateTime)], CommandType='Text', CommandTimeout='30']&#xD;
      SELECT * FROM institutional_outbox_events WHERE&#xD;
      (("Status" IN ('Pending','Retry') AND ("NextAttemptAtUtc" IS NULL OR "NextAttemptAtUtc"&lt;=@p0))&#xD;
       OR ("Status"='Processing' AND "LeaseUntilUtc"&lt;=@p1))&#xD;
      ORDER BY "CreatedAtUtc","Id" LIMIT 1 FOR UPDATE SKIP LOCKED&#xD;
info: Microsoft.EntityFrameworkCore.Database.Command[20101]&#xD;
      Executed DbCommand (1ms) [Parameters=[@now='?' (DbType = DateTime), @cursor='?' (DbType = Guid), @p='?' (DbType = Int32)], CommandType='Text', CommandTimeout='30']&#xD;
      SELECT e."Id"&#xD;
      FROM exam_attempts AS e&#xD;
      WHERE e."Status" = 'InProgress' AND e."DeadlineUtc" &lt;= @now AND e."Id" &gt; @cursor&#xD;
      ORDER BY e."Id"&#xD;
      LIMIT @p&#xD;
