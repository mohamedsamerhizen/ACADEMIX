          CONSTRAINT "FK_grade_reports_attempt" FOREIGN KEY ("AttemptId", "ExamId", "InstitutionId", "CourseId") REFERENCES exam_attempts ("Id", "ExamId", "InstitutionId", "CourseId") ON DELETE RESTRICT&#xD;
