      CREATE TABLE campus_buildings (&#xD;
          "Id" uuid NOT NULL,&#xD;
          "InstitutionId" uuid NOT NULL,&#xD;
          "Code" character varying(30) NOT NULL,&#xD;
          "Name" character varying(160) NOT NULL,&#xD;
          "IsActive" boolean NOT NULL,&#xD;
          "Version" bigint NOT NULL,&#xD;
