      CREATE FUNCTION p22_deny_class_session_revision_mutation() RETURNS trigger AS $$&#xD;
BEGIN&#xD;
    RAISE EXCEPTION 'Class session revision history is immutable';&#xD;
END;&#xD;
$$ LANGUAGE plpgsql;&#xD;
