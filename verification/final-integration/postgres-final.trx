          CONSTRAINT "FK_p8_submission_team" FOREIGN KEY ("TeamId", "SectionId", "InstitutionId") REFERENCES lms_project_teams ("Id", "SectionId", "InstitutionId") ON DELETE RESTRICT,&#xD;
          CONSTRAINT "FK_p8_submission_editor" FOREIGN KEY ("LastEditedBy") REFERENCES identity_users ("Id") ON DELETE RESTRICT,&#xD;
