info: Microsoft.EntityFrameworkCore.Database.Command[20101]&#xD;
      Executed DbCommand (1ms) [Parameters=[@inst='?' (DbType = Guid), @cutoff='?' (DbType = DateTime), @cutoff3='?' (DbType = DateTime), @account='?' (DbType = Guid)], CommandType='Text', CommandTimeout='30']&#xD;
      SELECT f."InvoiceId" AS "Id", COALESCE(sum(f."SignedMinor"), 0.0)::bigint AS "Amount"&#xD;
      FROM finance_adjustments AS f&#xD;
      INNER JOIN (&#xD;
          SELECT f0."Id"&#xD;
          FROM finance_journals AS f0&#xD;
          WHERE f0."InstitutionId" = @inst AND f0."PostedAtUtc" &lt; @cutoff&#xD;
      ) AS f1 ON f."JournalId" = f1."Id"&#xD;
      WHERE f."InvoiceId" IN (&#xD;
          SELECT f2."Id"&#xD;
          FROM finance_invoices AS f2&#xD;
          WHERE f2."InstitutionId" = @inst AND f2."Status" &lt;&gt; 'Draft' AND f2."PostedAtUtc" &lt; @cutoff3 AND f2."AccountId" = @account&#xD;
      )&#xD;
      GROUP BY f."InvoiceId"&#xD;
info: Microsoft.EntityFrameworkCore.Database.Command[20101]&#xD;
      Executed DbCommand (1ms) [Parameters=[@inst='?' (DbType = Guid), @cutoff='?' (DbType = DateTime), @cutoff3='?' (DbType = DateTime), @account='?' (DbType = Guid)], CommandType='Text', CommandTimeout='30']&#xD;
      SELECT f."InvoiceId" AS "Id", COALESCE(sum(CASE&#xD;
          WHEN f."Kind" = 'ScholarshipGranted' THEN f."AmountMinor"&#xD;
          ELSE -f."AmountMinor"&#xD;
      END), 0.0)::bigint AS "Amount"&#xD;
      FROM finance_journals AS f&#xD;
      WHERE f."InstitutionId" = @inst AND f."PostedAtUtc" &lt; @cutoff AND f."InvoiceId" IS NOT NULL AND f."InvoiceId" IN (&#xD;
          SELECT f0."Id"&#xD;
          FROM finance_invoices AS f0&#xD;
          WHERE f0."InstitutionId" = @inst AND f0."Status" &lt;&gt; 'Draft' AND f0."PostedAtUtc" &lt; @cutoff3 AND f0."AccountId" = @account&#xD;
      ) AND f."Kind" IN ('ScholarshipGranted', 'ScholarshipReclaimed')&#xD;
      GROUP BY f."InvoiceId"&#xD;
