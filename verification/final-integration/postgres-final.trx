          CONSTRAINT "FK_p24_rubric_outcome" FOREIGN KEY ("OutcomeId", "ProgramId", "InstitutionId") REFERENCES quality_program_outcomes ("Id", "ProgramId", "InstitutionId") ON DELETE RESTRICT,&#xD;
