      CREATE TABLE registrar_applicants (&#xD;
          "Id" uuid NOT NULL,&#xD;
          "InstitutionId" uuid NOT NULL,&#xD;
          "ClientRequestId" uuid NOT NULL,&#xD;
          "Email" character varying(256) NOT NULL,&#xD;
          "NormalizedEmail" character varying(256) NOT NULL,&#xD;
          "FullName" character varying(200) NOT NULL,&#xD;
          "ProgramId" uuid NOT NULL,&#xD;
          "TermId" uuid NOT NULL,&#xD;
          "Statement" character varying(3000) NOT NULL,&#xD;
          "Status" character varying(20) NOT NULL,&#xD;
          "ProtectedInvitation" text NOT NULL,&#xD;
          "InvitationHash" character varying(64) NOT NULL,&#xD;
          "InvitationExpiresAtUtc" timestamp with time zone NOT NULL,&#xD;
          "VerifiedAtUtc" timestamp with time zone,&#xD;
          "CreatedBy" uuid NOT NULL,&#xD;
          "ReviewedBy" uuid,&#xD;
          "StudentId" uuid,&#xD;
          "AdmissionId" uuid,&#xD;
          "DecisionReason" character varying(500),&#xD;
          "Version" bigint NOT NULL,&#xD;
          CONSTRAINT "PK_registrar_applicants" PRIMARY KEY ("Id"),&#xD;
          CONSTRAINT "AK_registrar_applicants_Id_InstitutionId" UNIQUE ("Id", "InstitutionId"),&#xD;
          CONSTRAINT "CK_applicant_status" CHECK ("Status" IN ('Invited','Submitted','Accepted','Rejected','Converted')),&#xD;
          CONSTRAINT "FK_registrar_applicants_academic_programs_ProgramId_Institutio~" FOREIGN KEY ("ProgramId", "InstitutionId") REFERENCES academic_programs ("Id", "InstitutionId") ON DELETE RESTRICT,&#xD;
          CONSTRAINT "FK_registrar_applicants_academic_terms_TermId_InstitutionId" FOREIGN KEY ("TermId", "InstitutionId") REFERENCES academic_terms ("Id", "InstitutionId") ON DELETE RESTRICT,&#xD;
          CONSTRAINT "FK_registrar_applicants_identity_users_CreatedBy" FOREIGN KEY ("CreatedBy") REFERENCES identity_users ("Id") ON DELETE RESTRICT,&#xD;
          CONSTRAINT "FK_registrar_applicants_identity_users_ReviewedBy" FOREIGN KEY ("ReviewedBy") REFERENCES identity_users ("Id") ON DELETE RESTRICT,&#xD;
          CONSTRAINT "FK_registrar_applicants_identity_users_StudentId" FOREIGN KEY ("StudentId") REFERENCES identity_users ("Id") ON DELETE RESTRICT,&#xD;
          CONSTRAINT "FK_registrar_applicants_institutions_InstitutionId" FOREIGN KEY ("InstitutionId") REFERENCES institutions ("Id") ON DELETE RESTRICT&#xD;
      );&#xD;
