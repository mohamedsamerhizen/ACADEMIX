      CREATE TABLE institutional_import_rows (&#xD;
          "Id" uuid NOT NULL,&#xD;
          "InstitutionId" uuid NOT NULL,&#xD;
          "JobId" uuid NOT NULL,&#xD;
          "Number" integer NOT NULL,&#xD;
          "PayloadJson" jsonb NOT NULL,&#xD;
          "Status" character varying(20) NOT NULL,&#xD;
          "Issue" character varying(500),&#xD;
          "StudentId" uuid,&#xD;
          "AppliedAtUtc" timestamp with time zone,&#xD;
          CONSTRAINT "PK_institutional_import_rows" PRIMARY KEY ("Id"),&#xD;
          CONSTRAINT "AK_institutional_import_rows_Id_InstitutionId" UNIQUE ("Id", "InstitutionId"),&#xD;
          CONSTRAINT "CK_import_row_state" CHECK ("Status" IN ('Pending','Valid','Invalid','Applied','Failed') AND "Number" BETWEEN 1 AND 1000),&#xD;
          CONSTRAINT "FK_institutional_import_rows_institutional_import_jobs_JobId_I~" FOREIGN KEY ("JobId", "InstitutionId") REFERENCES institutional_import_jobs ("Id", "InstitutionId") ON DELETE RESTRICT&#xD;
      );&#xD;
info: Microsoft.EntityFrameworkCore.Database.Command[20101]&#xD;
      Executed DbCommand (3ms) [Parameters=[@inst='?' (DbType = Guid), @student='?' (DbType = Guid), @plan_ProgramId='?' (DbType = Guid)], CommandType='Text', CommandTimeout='30']&#xD;
      SELECT t."TargetCourseId", t0."OriginInstitution", t."OriginCourseCode"&#xD;
      FROM transfer_credit_lines AS t&#xD;
      INNER JOIN transfer_credit_petitions AS t0 ON t."PetitionId" = t0."Id"&#xD;
      WHERE t0."InstitutionId" = @inst AND t."InstitutionId" = @inst AND t0."StudentId" = @student AND t0."ProgramId" = @plan_ProgramId AND t0."Status" = 'Approved'&#xD;
