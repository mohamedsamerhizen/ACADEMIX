          CONSTRAINT "FK_registrar_applicants_academic_programs_ProgramId_Institutio~" FOREIGN KEY ("ProgramId", "InstitutionId") REFERENCES academic_programs ("Id", "InstitutionId") ON DELETE RESTRICT,&#xD;
