          CONSTRAINT "FK_finance_awards_finance_invoices_InvoiceId_InstitutionId" FOREIGN KEY ("InvoiceId", "InstitutionId") REFERENCES finance_invoices ("Id", "InstitutionId") ON DELETE RESTRICT,&#xD;
