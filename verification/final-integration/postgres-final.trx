      Executed DbCommand (2ms) [Parameters=[@institutionId='?' (DbType = Guid), @now='?' (DbType = DateTime), @program='?' (DbType = Guid)], CommandType='Text', CommandTimeout='30']&#xD;
      SELECT r."Id", r."CreatedAtUtc", r."CreatedBy", r."EffectiveFromUtc", r."EffectiveUntilUtc", r."InstitutionId", r."ProgramId", r."PublishedAtUtc", r."PublishedBy", r."RulesJson", r."Status"&#xD;
      FROM registrar_policy_revisions AS r&#xD;
      WHERE r."InstitutionId" = @institutionId AND r."Status" = 'Published' AND r."EffectiveFromUtc" &lt;= @now AND r."EffectiveUntilUtc" &gt; @now AND (r."ProgramId" IS NULL OR r."ProgramId" = @program)&#xD;
