      CREATE FUNCTION failure_357a3735ef524bbd986f93c4c231907b() RETURNS trigger LANGUAGE plpgsql AS $body$&#xD;
BEGIN IF NEW."Action"='exam.attempt.timeout' AND NEW."Target" IN ('0963f3ef-209f-4063-9db4-a00203331b34')&#xD;
  THEN RAISE EXCEPTION 'Injected timeout audit failure'; END IF; RETURN NEW; END $body$;&#xD;
