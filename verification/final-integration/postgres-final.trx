          CONSTRAINT "PK_quality_program_reviews" PRIMARY KEY ("Id"),&#xD;
          CONSTRAINT "AK_quality_program_reviews_Id_InstitutionId" UNIQUE ("Id", "InstitutionId"),&#xD;
          CONSTRAINT "CK_p24_review_status" CHECK ("Status" IN ('Draft','Published')),&#xD;
