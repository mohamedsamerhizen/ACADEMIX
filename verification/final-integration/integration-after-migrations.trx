      CREATE TABLE study_plan_courses (&#xD;
          "Id" uuid NOT NULL,&#xD;
          "InstitutionId" uuid NOT NULL,&#xD;
          "RevisionId" uuid NOT NULL,&#xD;
          "CourseId" uuid NOT NULL,&#xD;
