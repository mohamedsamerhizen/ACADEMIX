      ALTER TABLE study_plan_revisions ADD CONSTRAINT "FK_study_plan_revisions_curriculum_plans_CurriculumPlanId_Inst~" FOREIGN KEY ("CurriculumPlanId", "InstitutionId") REFERENCES curriculum_plans ("Id", "InstitutionId") ON DELETE RESTRICT;&#xD;
