      CREATE TABLE lifecycle_decision_events (&#xD;
          "Id" uuid NOT NULL,&#xD;
          "InstitutionId" uuid NOT NULL,&#xD;
          "StudentId" uuid NOT NULL,&#xD;
          "ActorId" uuid NOT NULL,&#xD;
