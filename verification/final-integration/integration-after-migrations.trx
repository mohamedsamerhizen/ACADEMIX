          "Version" bigint NOT NULL,&#xD;
          CONSTRAINT "PK_exam_attempts" PRIMARY KEY ("Id"),&#xD;
          CONSTRAINT "AK_exam_attempts_Id_ExamId_InstitutionId_CourseId" UNIQUE ("Id", "ExamId", "InstitutionId", "CourseId"),&#xD;
          CONSTRAINT "CK_exam_attempts_number" CHECK ("AttemptNumber" BETWEEN 1 AND 10),&#xD;
          CONSTRAINT "CK_exam_attempts_status" CHECK ("Status" IN ('InProgress','Submitted','Expired')),&#xD;
          CONSTRAINT "CK_exam_attempts_deadline" CHECK ("DeadlineUtc" &gt; "StartedAtUtc"),&#xD;
          CONSTRAINT "FK_exam_attempts_exam" FOREIGN KEY ("ExamId", "InstitutionId", "CourseId") REFERENCES exam_definitions ("Id", "InstitutionId", "CourseId") ON DELETE RESTRICT,&#xD;
          CONSTRAINT "FK_exam_attempts_student" FOREIGN KEY ("StudentId") REFERENCES identity_users ("Id") ON DELETE RESTRICT&#xD;
      );&#xD;
