      CREATE TABLE registrar_exceptions (&#xD;
          "Id" uuid NOT NULL,&#xD;
          "InstitutionId" uuid NOT NULL,&#xD;
          "StudentId" uuid NOT NULL,&#xD;
          "SectionId" uuid NOT NULL,&#xD;
          "PolicyId" uuid NOT NULL,&#xD;
          "Rule" character varying(30) NOT NULL,&#xD;
          "Reason" character varying(500) NOT NULL,&#xD;
          "Status" character varying(20) NOT NULL,&#xD;
          "RequestedBy" uuid NOT NULL,&#xD;
          "ReviewedBy" uuid,&#xD;
          "ReviewedAtUtc" timestamp with time zone,&#xD;
          "ExpiresAtUtc" timestamp with time zone NOT NULL,&#xD;
          CONSTRAINT "PK_registrar_exceptions" PRIMARY KEY ("Id"),&#xD;
          CONSTRAINT "AK_registrar_exceptions_Id_InstitutionId" UNIQUE ("Id", "InstitutionId"),&#xD;
          CONSTRAINT "CK_registrar_exception" CHECK ("Status" IN ('Pending','Approved','Rejected') AND "Rule" IN ('Prerequisites','CreditLoad','EnrollmentApproval')),&#xD;
          CONSTRAINT "FK_registrar_exceptions_course_sections_SectionId_InstitutionId" FOREIGN KEY ("SectionId", "InstitutionId") REFERENCES course_sections ("Id", "InstitutionId") ON DELETE RESTRICT,&#xD;
          CONSTRAINT "FK_registrar_exceptions_institutions_InstitutionId" FOREIGN KEY ("InstitutionId") REFERENCES institutions ("Id") ON DELETE RESTRICT,&#xD;
          CONSTRAINT "FK_registrar_exceptions_registrar_policy_revisions_PolicyId_In~" FOREIGN KEY ("PolicyId", "InstitutionId") REFERENCES registrar_policy_revisions ("Id", "InstitutionId") ON DELETE RESTRICT&#xD;
      );&#xD;
