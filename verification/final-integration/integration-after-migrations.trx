      CREATE TABLE graduation_applications (&#xD;
          "Id" uuid NOT NULL,&#xD;
          "InstitutionId" uuid NOT NULL,&#xD;
          "StudentId" uuid NOT NULL,&#xD;
          "ProgramId" uuid NOT NULL,&#xD;
          "PlanId" uuid NOT NULL,&#xD;
          "Status" character varying(20) NOT NULL,&#xD;
          "Version" bigint NOT NULL,&#xD;
          "ReviewedById" uuid,&#xD;
          "DecisionReason" character varying(500),&#xD;
          "CreatedAtUtc" timestamp with time zone NOT NULL,&#xD;
          "ReviewedAtUtc" timestamp with time zone,&#xD;
          "IssuedById" uuid,&#xD;
          "CredentialNumber" character varying(64),&#xD;
          "IssuedAtUtc" timestamp with time zone,&#xD;
          CONSTRAINT "PK_graduation_applications" PRIMARY KEY ("Id"),&#xD;
          CONSTRAINT "CK_p16_graduation_status" CHECK ("Status" IN ('Submitted','Approved','Rejected','Issued')),&#xD;
          CONSTRAINT "FK_p16_graduation_program" FOREIGN KEY ("ProgramId", "InstitutionId") REFERENCES academic_programs ("Id", "InstitutionId") ON DELETE RESTRICT,&#xD;
          CONSTRAINT "FK_p16_graduation_plan" FOREIGN KEY ("PlanId", "InstitutionId") REFERENCES curriculum_plans ("Id", "InstitutionId") ON DELETE RESTRICT,&#xD;
          CONSTRAINT "FK_p16_graduation_student" FOREIGN KEY ("StudentId") REFERENCES identity_users ("Id") ON DELETE RESTRICT,&#xD;
          CONSTRAINT "FK_p16_graduation_reviewer" FOREIGN KEY ("ReviewedById") REFERENCES identity_users ("Id") ON DELETE RESTRICT,&#xD;
          CONSTRAINT "FK_p16_graduation_issuer" FOREIGN KEY ("IssuedById") REFERENCES identity_users ("Id") ON DELETE RESTRICT&#xD;
      );&#xD;
