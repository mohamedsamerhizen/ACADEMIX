          CONSTRAINT "FK_finance_scholarships_academic_terms_TermId_InstitutionId" FOREIGN KEY ("TermId", "InstitutionId") REFERENCES academic_terms ("Id", "InstitutionId") ON DELETE RESTRICT,&#xD;
