          CONSTRAINT "CK_timetable_time" CHECK ("Weekday" BETWEEN 1 AND 7 AND "StartsAtMinute" BETWEEN 0 AND 1439 AND "DurationMinutes" BETWEEN 15 AND 600 AND "StartsAtMinute" + "DurationMinutes" &lt;= 1440),&#xD;
          CONSTRAINT "FK_timetable_section" FOREIGN KEY ("SectionId", "InstitutionId") REFERENCES course_sections ("Id", "InstitutionId") ON DELETE RESTRICT&#xD;
      );&#xD;
