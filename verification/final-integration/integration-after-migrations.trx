      CREATE TRIGGER p20_graduation_scope BEFORE INSERT OR UPDATE ON graduation_applications FOR EACH ROW EXECUTE FUNCTION p20_user_scope('StudentId','ReviewedById','IssuedById','DepartmentReviewedById');&#xD;
