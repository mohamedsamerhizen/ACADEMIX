      CREATE TABLE academic_calendar_events (&#xD;
          "Id" uuid NOT NULL,&#xD;
          "InstitutionId" uuid NOT NULL,&#xD;
          "TermId" uuid,&#xD;
          "SectionId" uuid,&#xD;
          "Title" character varying(160) NOT NULL,&#xD;
          "Description" character varying(2000) NOT NULL,&#xD;
          "StartsAtUtc" timestamp with time zone NOT NULL,&#xD;
          "EndsAtUtc" timestamp with time zone NOT NULL,&#xD;
          "Audience" character varying(20) NOT NULL,&#xD;
          "IsPublished" boolean NOT NULL,&#xD;
          "CreatedBy" uuid NOT NULL,&#xD;
          CONSTRAINT "PK_academic_calendar_events" PRIMARY KEY ("Id"),&#xD;
          CONSTRAINT "CK_calendar_times" CHECK ("EndsAtUtc" &gt; "StartsAtUtc"),&#xD;
          CONSTRAINT "CK_calendar_audience" CHECK ("Audience" IN ('All','Staff','Students')),&#xD;
          CONSTRAINT "FK_calendar_institution" FOREIGN KEY ("InstitutionId") REFERENCES institutions ("Id") ON DELETE RESTRICT,&#xD;
