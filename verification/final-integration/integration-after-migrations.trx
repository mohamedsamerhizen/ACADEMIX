      CREATE TABLE academic_timetable_slots (&#xD;
          "Id" uuid NOT NULL,&#xD;
          "InstitutionId" uuid NOT NULL,&#xD;
          "SectionId" uuid NOT NULL,&#xD;
          "Weekday" integer NOT NULL,&#xD;
