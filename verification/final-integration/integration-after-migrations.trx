          CONSTRAINT "FK_registrar_eligibility_decisions_institutions_InstitutionId" FOREIGN KEY ("InstitutionId") REFERENCES institutions ("Id") ON DELETE RESTRICT,&#xD;
          CONSTRAINT "FK_registrar_eligibility_decisions_registrar_policy_revisions_~" FOREIGN KEY ("PolicyId", "InstitutionId") REFERENCES registrar_policy_revisions ("Id", "InstitutionId") ON DELETE RESTRICT&#xD;
