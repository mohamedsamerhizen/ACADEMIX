AUDIT_RESULT {"Probe":"CampusReadMissingAuthority","Operation":"RoomOccupancy","UnauthenticatedPrincipal":true,"AuthorizationServiceAbsent":true,"ResourceSqlReached":true,"DatabaseExecuted":false,"Sql":"SELECT EXISTS (\r\n    SELECT 1\r\n    FROM campus_rooms AS c\r\n    WHERE c.\u0022InstitutionId\u0022 = @institutionId AND c.\u0022Id\u0022 = @roomId)"}
AUDIT_RESULT {"Probe":"CampusReadMissingAuthority","Operation":"InstitutionCalendar","UnauthenticatedPrincipal":true,"AuthorizationServiceAbsent":true,"ResourceSqlReached":true,"DatabaseExecuted":false,"Sql":"SELECT a.\u0022Id\u0022, a.\u0022SectionId\u0022, a.\u0022RoomId\u0022, a.\u0022StartsAtUtc\u0022, a.\u0022EndsAtUtc\u0022, a.\u0022Status\u0022\r\nFROM academic_class_sessions AS a\r\nWHERE a.\u0022InstitutionId\u0022 = @institutionId AND a.\u0022StartsAtUtc\u0022 \u003C @toUtc AND a.\u0022EndsAtUtc\u0022 \u003E @fromUtc\r\nORDER BY a.\u0022StartsAtUtc\u0022\r\nLIMIT @p"}
AUDIT_RESULT {"Probe":"CampusReadMissingAuthority","Operation":"AvailableAt","UnauthenticatedPrincipal":true,"AuthorizationServiceAbsent":true,"ResourceSqlReached":true,"DatabaseExecuted":false,"Sql":"SELECT c.\u0022Id\u0022, c.\u0022InstitutionId\u0022, c.\u0022BuildingId\u0022, c.\u0022Code\u0022, c.\u0022Name\u0022, c.\u0022Kind\u0022, c.\u0022Capacity\u0022, c.\u0022IsActive\u0022, c.\u0022Version\u0022\r\nFROM campus_rooms AS c\r\nWHERE c.\u0022InstitutionId\u0022 = @institutionId AND c.\u0022IsActive\u0022 AND c.\u0022Capacity\u0022 \u003E= @requiredCapacity AND EXISTS (\r\n    SELECT 1\r\n    FROM campus_buildings AS c0\r\n    WHERE c0.\u0022Id\u0022 = c.\u0022BuildingId\u0022 AND c0.\u0022InstitutionId\u0022 = @institutionId AND c0.\u0022IsActive\u0022) AND NOT EXISTS (\r\n    SELECT 1\r\n    FROM campus_room_reservations AS c1\r\n    WHERE c1.\u0022InstitutionId\u0022 = @institutionId AND c1.\u0022RoomId\u0022 = c.\u0022Id\u0022 AND c1.\u0022Status\u0022 = \u0027Active\u0027 AND c1.\u0022StartsAtUtc\u0022 \u003C @toUtc AND c1.\u0022EndsAtUtc\u0022 \u003E @fromUtc) AND NOT EXISTS (\r\n    SELECT 1\r\n    FROM academic_class_sessions AS a\r\n    WHERE a.\u0022InstitutionId\u0022 = @institutionId AND a.\u0022Status\u0022 \u003C\u003E \u0027Cancelled\u0027 AND a.\u0022StartsAtUtc\u0022 \u003C @toUtc AND a.\u0022EndsAtUtc\u0022 \u003E @fromUtc AND (a.\u0022RoomId\u0022 = c.\u0022Id\u0022 OR (a.\u0022RoomId\u0022 IS NULL AND a.\u0022TimetableSlotId\u0022 IS NOT NULL AND EXISTS (\r\n        SELECT 1\r\n        FROM academic_timetable_slots AS a0\r\n        WHERE a0.\u0022Id\u0022 = a.\u0022TimetableSlotId\u0022 AND a0.\u0022SectionId\u0022 = a.\u0022SectionId\u0022 AND a0.\u0022InstitutionId\u0022 = @institutionId AND a0.\u0022RoomId\u0022 = c.\u0022Id\u0022))))\r\nORDER BY c.\u0022BuildingId\u0022, c.\u0022Code\u0022\r\nLIMIT @p"}
